@model ErrorViewModel
@{
    var notFound = Model.Code == 404;
    ViewData["Title"] = notFound ? "Page not found" : "Something went wrong";
}

<div class="text-center py-5">
    <p class="display-1 fw-bold text-muted mb-0">@(notFound ? "404" : "Oops")</p>
    <h1 class="h3 mb-3">@(notFound ? "We could not find that page." : "Something went wrong on our side.")</h1>
    <p class="text-muted">
        @(notFound ? "The link may be old, or the product is no longer sold." : "Please try again. If it keeps happening, mention the request ID below.")
    </p>
    @if (Model.ShowRequestId && !notFound)
    {
        <p class="small text-muted">Request ID: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-brand" asp-controller="Shop" asp-action="Index">Back to the shop</a>
</div>
