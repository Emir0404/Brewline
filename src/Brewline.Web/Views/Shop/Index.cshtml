@model ShopPage
@{
    ViewData["Title"] = Model.Category ?? "Shop";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h1 class="h3 mb-0">@(Model.Category ?? "All products")</h1>
    <form method="get" class="d-flex gap-2" role="search">
        @if (!string.IsNullOrEmpty(Model.Category))
        {
            <input type="hidden" name="category" value="@Model.Category" />
        }
        <input type="search" name="q" value="@Model.Search" class="form-control" placeholder="Search products" aria-label="Search products" />
        <button class="btn btn-outline-dark" type="submit">Search</button>
    </form>
</div>

<div class="mb-4 d-flex flex-wrap gap-2">
    <a class="btn btn-sm @(Model.Category is null ? "btn-dark" : "btn-outline-dark")" asp-action="Index" asp-route-q="@Model.Search">All</a>
    @foreach (var category in Model.Categories)
    {
        <a class="btn btn-sm @(Model.Category == category ? "btn-dark" : "btn-outline-dark")" asp-action="Index" asp-route-category="@category" asp-route-q="@Model.Search">@category</a>
    }
</div>

@if (Model.Products.Count == 0)
{
    <div class="text-center text-muted py-5">
        <p class="h5">Nothing matches that.</p>
        <a asp-action="Index">Clear filters</a>
    </div>
}
else
{
    <div class="row g-3 row-cols-1 row-cols-sm-2 row-cols-lg-4">
        @foreach (var product in Model.Products)
        {
            <div class="col"><partial name="_ProductCard" model="product" /></div>
        }
    </div>
}
