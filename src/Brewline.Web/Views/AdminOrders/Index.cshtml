@model IReadOnlyList<Order>
@{
    ViewData["Title"] = "Orders";
    var current = (OrderStatus?)ViewBag.Status;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Orders</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-dark" asp-controller="AdminProducts" asp-action="Index">Products</a>
        <form asp-controller="AdminAccount" asp-action="Logout" method="post"><button class="btn btn-outline-secondary" type="submit">Log out</button></form>
    </div>
</div>

<div class="mb-3 d-flex flex-wrap gap-2">
    <a class="btn btn-sm @(current is null ? "btn-dark" : "btn-outline-dark")" asp-action="Index">All</a>
    @foreach (var status in Enum.GetValues<OrderStatus>())
    {
        <a class="btn btn-sm @(current == status ? "btn-dark" : "btn-outline-dark")" asp-action="Index" asp-route-status="@status">@status</a>
    }
</div>

<div class="card">
    @if (Model.Count == 0)
    {
        <div class="card-body text-muted">No orders here.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead><tr><th>Order</th><th>Placed</th><th>Customer</th><th>Status</th><th class="text-end">Total</th></tr></thead>
                <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@order.Id">@order.Reference</a></td>
                        <td>@order.CreatedAt.ToString("dd MMM HH:mm")</td>
                        <td>@order.CustomerName <span class="text-muted small">@order.Email</span></td>
                        <td><span class="badge text-bg-@(order.Status switch { OrderStatus.Paid => "success", OrderStatus.Shipped => "primary", OrderStatus.Pending => "warning", OrderStatus.NeedsReview => "danger", _ => "secondary" })">@order.Status</span></td>
                        <td class="text-end">@Pricing.Format(order.TotalCents, order.Currency)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
